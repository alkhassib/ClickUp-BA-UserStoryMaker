# API token of the dedicated BOT user (not a BA's personal token).
CLICKUP_API_TOKEN=pk_xxx
# Optional: overrides clickup.team_id in config/settings.yaml
CLICKUP_TEAM_ID=

# Only the key for the configured llm.provider is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Webhook / hybrid mode: printed by `ba-flow webhook register` (or saved with --save).
CLICKUP_WEBHOOK_ID=
CLICKUP_WEBHOOK_SECRET=
